//A MAIN:

package prova;

import java.util.ArrayList;
import java.util.Scanner;

public class Main {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		ArrayList<Veiculo> lista = new ArrayList<>();
		System.out.println("Quantos veículos deseja cadastrar?");
		int num = sc.nextInt();
		for (int i = 1; i <= num; i++) {
			System.out.println("Cadastro do veículo " + i + ": ");
			System.out.println("Tipo do veículo \n(1-Carro, 2-Moto, 3-Caminhão)");
			int tipo = sc.nextInt();
			sc.nextLine();
			if (tipo == 1) {
				System.out.print("Marca: ");
				String marca = sc.nextLine();
				System.out.print("Modelo: ");
				String modelo = sc.nextLine();
				System.out.print("Placa: ");
				String placa = sc.nextLine();
				System.out.print("Ano de fabricação: ");
				int ano = sc.nextInt();
				System.out.println("Categoria - (1-Popular, 2-Sedan, 3-SUV):  ");
				String categoria = sc.next();
				lista.add(new Carro(marca, modelo, placa, ano, categoria));

			} else if (tipo == 2) {
				System.out.print("Marca: ");
				String marca = sc.nextLine();
				System.out.print("Modelo: ");
				String modelo = sc.nextLine();
				System.out.print("Placa: ");
				String placa = sc.nextLine();
				System.out.print("Ano de fabricação: ");
				int ano = sc.nextInt();
				System.out.print("Cilindradas: ");
				int cilindradas = sc.nextInt();
				lista.add(new Moto(marca, modelo, placa, ano, cilindradas));
			} else if (tipo == 3) {
				System.out.print("Marca: ");
				String marca = sc.nextLine();
				System.out.print("Modelo: ");
				String modelo = sc.nextLine();
				System.out.print("Placa: ");
				String placa = sc.nextLine();
				System.out.print("Ano de fabricação: ");
				int ano = sc.nextInt();
				System.out.print("Capacidade de carga (Tolenadas): ");
				double carga = sc.nextDouble();
				lista.add(new Caminhão(marca, modelo, placa, ano, carga));
			} else {
				System.out.println("Opção inválida! Tente novamente");
				i--;
			}
		}
		double total = 0;
		System.out.println("Veículos cadastrados e valor do aluguel:");
		for (Veiculo v : lista) {
			System.out.println(v + "Valor do Aluguel: R$ " + v.CalcularValorAluguel());
			total += v.CalcularValorAluguel();
		}
		System.out.println("Valor total arrecadado: R$ " + total);
		sc.close();
	}

}


//CLASSE VEICULO:

package prova;

public abstract class Veiculo {

	protected String marca;
	protected String modelo;
	protected String placa;
	protected int ano;

	public Veiculo(String marca, String modelo, String placa, int ano) {
		this.marca = marca;
		this.modelo = modelo;
		this.placa = placa;
		this.ano = ano;
	}

	public String getMarca() {
		return marca;
	}

	public void setMarca(String marca) {
		this.marca = marca;
	}

	public String getModelo() {
		return modelo;
	}

	public void setModelo(String modelo) {
		this.modelo = modelo;
	}

	public String getPlaca() {
		return placa;
	}

	public void setPlaca(String placa) {
		this.placa = placa;
	}

	public int getAno() {
		return ano;
	}

	public void setAno(int ano) {
		this.ano = ano;
	}

	public abstract double CalcularValorAluguel();

	@Override
	public String toString() {
		return "";
	}

}

//CLASSE CARRO:

package prova;

public class Carro extends Veiculo {
	private String categoria;

	public Carro(String marca, String modelo, String placa, int ano, String categoria) {
		super(marca, modelo, placa, ano);
		this.categoria = categoria;
	}

	public String getCategoria() {
		return categoria;
	}

	public void setCategoria(String categoria) {
		this.categoria = categoria;
	}

	@Override
	public double CalcularValorAluguel() {
		double aluguel;
		if (categoria.equals("1")) {
			aluguel = 100;
		} else if (categoria.equals("2")) {
			aluguel = 150;
		} else {
			aluguel = 200;
		}
		return aluguel;

	}

	@Override
	public String toString() {
		return marca + ", " + modelo + " (" + ano + ") - Placa: " + placa + " - ";
	}

}

//CLASSE MOTO:

package prova;

public class Moto extends Veiculo {
	private int cilindradas;

	public Moto(String marca, String modelo, String placa, int ano, int cilindradas) {
		super(marca, modelo, placa, ano);
		this.cilindradas = cilindradas;
	}

	public int getCilindradas() {
		return cilindradas;
	}

	public void setCilindradas(int cilindradas) {
		this.cilindradas = cilindradas;
	}

	@Override
	public double CalcularValorAluguel() {
		double aluguel = 50 + cilindradas;
		return aluguel;
	}

	@Override
	public String toString() {
		return marca + ", " + modelo + " (" + ano + ") - Placa: " + placa + " - ";
	}

}

//CLASSE CAMINHÃO:

package prova;

public class Caminhão extends Veiculo {
	private double CapacidadeCarga;

	public Caminhão(String marca, String modelo, String placa, int ano, double capacidadeCarga) {
		super(marca, modelo, placa, ano);
		CapacidadeCarga = capacidadeCarga;
	}

	public double getCapacidadeCarga() {
		return CapacidadeCarga;
	}

	public void setCapacidadeCarga(double capacidadeCarga) {
		CapacidadeCarga = capacidadeCarga;
	}

	@Override
	public double CalcularValorAluguel() {
		double aluguel = 300 + (CapacidadeCarga * 20);
		return aluguel;
	}

	@Override
	public String toString() {
		return marca + ", " + modelo + " (" + ano + ") - Placa: " + placa + " - ";
	}

}

