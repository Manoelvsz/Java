package principal;
import java.util.Scanner;

import prova.ContaUsuario;

public class Main {

	public static void main(String[] args) {
	Scanner sc = new Scanner (System.in);
	ContaUsuario emprestimo;
	
	String nome;
	int ID, emprestado, quantidade;
	int reduzir;
	
	System.out.println("Digite o ID do usuário: ");
	ID = sc.nextInt();
	sc.nextLine();
	System.out.println("Digite o nome do usuário: ");
	nome =sc.nextLine();
	System.out.println("Digite o número de livros emprestados atualmente: ");
	emprestado = sc.nextInt();
	
	System.out.println("Digite a quantidade de livros a serem emprestados: ");
	quantidade = sc.nextInt();
	System.out.println("Empréstimo de "+quantidade+ " livros realizado com sucesso.");
	
	emprestimo = new ContaUsuario(ID, nome, emprestado);
	
	emprestimo.emprestarLivro(quantidade);
	
	System.out.println(emprestimo);

	do {
	System.out.println("Digite a quantidade de livros a serem devolvidos: ");
	reduzir = sc.nextInt();
	}while(reduzir > emprestimo.exibirLivrosEmprestados());
	
	System.out.println("Devolução de "+reduzir+" livro realizada com sucesso.");
	
	emprestimo.devolverLivro(reduzir);
	
	System.out.println(emprestimo);
	
	
	}

}

